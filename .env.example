# Copy this file to .env for local development.
# These are development defaults only — never put real secrets in this file
# or in .env; production configuration is managed outside the repo.

# ---- General ----
ENVIRONMENT=development

# ---- PostgreSQL ----
POSTGRES_USER=ondas
POSTGRES_PASSWORD=ondas_dev_password
POSTGRES_DB=ondas_do_mar
POSTGRES_PORT=5432

# ---- Backend (FastAPI) ----
BACKEND_PORT=8000
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
INVITATION_TOKEN_EXPIRE_HOURS=168
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql+psycopg://ondas:ondas_dev_password@db:5432/ondas_do_mar
FRONTEND_BASE_URL=http://localhost:5173

# ---- Frontend (Nuxt) ----
FRONTEND_PORT=5173
NUXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ---- Future integrations (leave blank until configured) ----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Cloudflare R2 (apartment photos) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
